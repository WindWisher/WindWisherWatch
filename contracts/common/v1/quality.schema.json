{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windwisher.app/contracts/common/v1/quality.schema.json",
  "title": "Quality metadata v1",
  "description": "Reusable conservative quality and provenance definitions.",
  "$defs": {
    "qualityFlag": {
      "type": "string",
      "enum": [
        "gps_degraded",
        "sensor_dropout",
        "clock_discontinuity",
        "low_sample_rate",
        "calibration_unknown",
        "recovered_data",
        "position_unavailable",
        "barometer_unavailable"
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitudeDegrees", "longitudeDegrees"],
      "properties": {
        "latitudeDegrees": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitudeDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeMeters": {
          "type": "number",
          "minimum": -500,
          "maximum": 10000
        },
        "horizontalAccuracyMeters": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "verticalAccuracyMeters": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "algorithmMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithmVersion", "confidence", "qualityFlags"],
      "properties": {
        "algorithmVersion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "qualityFlags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/qualityFlag" }
        }
      }
    }
  }
}
