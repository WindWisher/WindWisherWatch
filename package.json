{
  "name": "windwisherwatch-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portable contract validation and architectural guards for WindWisherWatch.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "validate:contracts": "node tools/contracts/validate-contracts.mjs",
    "validate:garmin-lab": "node tools/garmin-sensor-lab/validate-fixtures.mjs",
    "validate:session-engine": "node --test tools/session-engine/*.test.mjs tools/session-engine/canonical-export/*.test.mjs",
    "guard:garmin-source": "node tools/garmin-sensor-lab/source-guards.mjs",
    "guard:session-engine": "node tools/session-engine/source-guards.mjs",
    "inspect:canonical": "node tools/session-engine/canonical-export/inspect.mjs",
    "test": "node --test tools/contracts/*.test.mjs tools/garmin-sensor-lab/*.test.mjs tools/session-engine/*.test.mjs tools/session-engine/canonical-export/*.test.mjs",
    "lint": "eslint tools --max-warnings=0",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test && npm run validate:contracts && npm run validate:garmin-lab && npm run validate:session-engine && npm run guard:garmin-source && npm run guard:session-engine"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "globals": "15.14.0",
    "prettier": "3.4.2"
  }
}
